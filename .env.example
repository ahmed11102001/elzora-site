# Public URL of the site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Digits only, international format, no "+" (e.g. 201000000000). The WhatsApp button is hidden when empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Set to "true" ONLY on the production deployment. Anything else serves "Disallow: /" in robots.txt.
ALLOW_INDEXING=false

# Development only (next dev): also show content whose status is "draft". Content with status
# "review" is always shown in development. Production serves only "published" content and ignores this.
SHOW_DRAFT_CONTENT=true

# Serve the internal /en/design page in production builds. Always available in dev.
ENABLE_DESIGN_PAGE=false

# Make `npm run build` fail while photos without a confirmed license are still in the site.
ENFORCE_IMAGE_LICENSES=false
