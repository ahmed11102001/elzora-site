# Public URL of the site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Digits only, international format, no "+" (e.g. 201000000000). The WhatsApp button is hidden when empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional. A real public contact email for the contact page. Hidden when empty. Never invent one.
NEXT_PUBLIC_CONTACT_EMAIL=

# Set to "true" ONLY on the production deployment. Anything else serves "Disallow: /" in robots.txt.
ALLOW_INDEXING=false

# Development only (next dev): also show content whose status is "draft". Content with status
# "review" is always shown in development. Production serves only "published" content and ignores this.
SHOW_DRAFT_CONTENT=true

# Pre-launch switch (decision D10): "review" content is shown on the live site so it can be checked.
# Set to "false" at launch: only "published" content is served. Unset or any other value = review content shown.
SHOW_REVIEW_CONTENT=true

# Serve the internal /en/design page in production builds. Always available in dev.
ENABLE_DESIGN_PAGE=false

# Make `npm run build` fail while photos without a confirmed license are still in the site.
ENFORCE_IMAGE_LICENSES=false

# ---- Trip planner & leads (Phase 6). Server-side secrets: never prefix them with NEXT_PUBLIC_. ----

# Postgres connection string (Supabase, Neon, Vercel Postgres ...). Without it the planner still loads,
# but submissions answer 503 and are NEVER reported as sent. Use the provider's pooled connection string
# on Vercel and add ?sslmode=require if the provider needs it. Create the tables with: npm run db:migrate
DATABASE_URL=

# Where trips come from: "seed" (the files in src/content/seed, the default) or "database" (Postgres).
# Switch to "database" only after: npm run db:migrate, npm run content:seed, npm run content:verify.
# Any other value is an error. In database mode a failing read is an error, never a silent fallback.
CONTENT_SOURCE=seed

# ---- Database roles (decision D2, docs/phase-7/7.7-kpis-and-hardening.md). All optional, all server-side. ----
# Create the roles once (db/spikes/roles.sql), then: npm run db:migrate && npm run db:grants && npm run db:verify-privileges
# Until a variable is set the site falls back to DATABASE_URL, so nothing breaks while you set them up one by one.
# DATABASE_URL stays the OWNER (migrations and scripts). Do not leave it on the website once the roles below are set.
#
# Content reads of the public site: published translations only (plus "review" until `npm run db:grants -- --launch`).
DATABASE_URL_PUBLIC=
# Signed draft preview only (can read drafts). Needed for preview once DATABASE_URL_PUBLIC is set.
DATABASE_URL_PREVIEW=
# The trip planner: it can add leads and nothing else.
DATABASE_URL_LEADS=

# Cloudflare Turnstile. Site key is public, secret key is server-only.
# Local testing keys from Cloudflare: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA (always pass).
# In production a missing secret makes submissions fail closed; TURNSTILE_DISABLED=true is an explicit opt-out (not recommended).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_DISABLED=false

# Resend. LEADS_EMAIL_FROM must be an address on a domain verified in Resend, e.g. "ELZORA <hello@your-domain>".
# LEADS_NOTIFY_TO is the team inbox (comma-separated for several). Missing values: the lead is still saved and
# the emails are retried later via the retry endpoint.
RESEND_API_KEY=
LEADS_EMAIL_FROM=
LEADS_NOTIFY_TO=

# Long random string used to hash IP addresses for rate limiting (e.g. `openssl rand -hex 32`).
LEADS_HASH_SALT=

# Protects /api/admin/leads/export and /api/admin/leads/retry-notifications (Authorization: Bearer <token>).
# At least 32 characters, e.g. `openssl rand -hex 32`. Empty = those endpoints answer 404.
LEADS_ADMIN_TOKEN=

# Optional. Where the "Rate us" button sends travelers (Google/Trustpilot review link). Falls back to WhatsApp.
NEXT_PUBLIC_REVIEW_URL=

# ---- Dashboard (Phase 7.4). Server-side secrets: never prefix them with NEXT_PUBLIC_. ----

# Host that serves the dashboard (and ONLY the dashboard), e.g. admin.your-domain.com. On any other host
# /admin answers 404. Locally the dashboard answers on admin.localhost:3000.
ADMIN_HOST=

# Supabase Auth, used for dashboard LOGIN only (create the owner user in the Supabase dashboard and enable MFA).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated e-mails that get the Owner role. No public registration exists.
DASHBOARD_OWNER_EMAILS=

# Optional connection used ONLY by the dashboard (decision D2: the "elzora_admin" role). Set it on the DASHBOARD
# deployment, never on the public one. Empty = the dashboard uses DATABASE_URL. With neither, local dev keeps throw-away in-memory trips and production refuses
# to open the trips screens (ALLOW_MEMORY_TRIP_STORE=true is for demos only).
ADMIN_DATABASE_URL=
ALLOW_MEMORY_TRIP_STORE=false

# Trip preview: secret shared by the dashboard (signs 15-minute preview links) and the PUBLIC site (verifies
# them). 16+ random characters, the SAME value on both. Empty = preview is off.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PREVIEW_SECRET=
