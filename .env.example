# Public URL of the site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Digits only, international format, no "+" (e.g. 201000000000). The WhatsApp button is hidden when empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Set to "true" ONLY on the production deployment. Anything else serves "Disallow: /" in robots.txt.
ALLOW_INDEXING=false

# Development only (next dev): also show content whose status is "draft". Content with status
# "review" is always shown in development. Production serves only "published" content and ignores this.
SHOW_DRAFT_CONTENT=true

# Serve the internal /en/design page in production builds. Always available in dev.
ENABLE_DESIGN_PAGE=false

# Make `npm run build` fail while photos without a confirmed license are still in the site.
ENFORCE_IMAGE_LICENSES=false

# ---- Trip planner & leads (Phase 6). Server-side secrets: never prefix them with NEXT_PUBLIC_. ----

# Postgres connection string (Supabase, Neon, Vercel Postgres ...). Without it the planner still loads,
# but submissions answer 503 and are NEVER reported as sent. Use the provider's pooled connection string
# on Vercel and add ?sslmode=require if the provider needs it. Create the tables with: npm run db:migrate
DATABASE_URL=

# Cloudflare Turnstile. Site key is public, secret key is server-only.
# Local testing keys from Cloudflare: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA (always pass).
# In production a missing secret makes submissions fail closed; TURNSTILE_DISABLED=true is an explicit opt-out (not recommended).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_DISABLED=false

# Resend. LEADS_EMAIL_FROM must be an address on a domain verified in Resend, e.g. "ELZORA <hello@your-domain>".
# LEADS_NOTIFY_TO is the team inbox (comma-separated for several). Missing values: the lead is still saved and
# the emails are retried later via the retry endpoint.
RESEND_API_KEY=
LEADS_EMAIL_FROM=
LEADS_NOTIFY_TO=

# Long random string used to hash IP addresses for rate limiting (e.g. `openssl rand -hex 32`).
LEADS_HASH_SALT=

# Protects /api/admin/leads/export and /api/admin/leads/retry-notifications (Authorization: Bearer <token>).
# At least 32 characters, e.g. `openssl rand -hex 32`. Empty = those endpoints answer 404.
LEADS_ADMIN_TOKEN=

# Optional. Where the "Rate us" button sends travelers (Google/Trustpilot review link). Falls back to WhatsApp.
NEXT_PUBLIC_REVIEW_URL=

# Dashboard (7.4A). Served only on the admin host (admin.<your-domain>; locally http://admin.localhost:3000).
# Supabase project URL + anon (publishable) key. The anon key is public by design; never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated e-mails that get the Owner role (the account must also exist in Supabase with a confirmed e-mail).
DASHBOARD_OWNER_EMAILS=
# Optional exact admin host (e.g. admin.example.com). Empty = any host starting with "admin.".
ADMIN_HOST=

# Dashboard database (7.4C). Optional privileged connection used ONLY by the dashboard (plan D2: the "admin"
# role). Empty = the dashboard uses DATABASE_URL. Without either, local dev uses throw-away in-memory trips
# and production refuses to start the trips screens (set ALLOW_MEMORY_TRIP_STORE=true only for demos).
# Create the tables with `npm run db:migrate`, then copy the seed trips with `npm run db:seed-trips`.
ADMIN_DATABASE_URL=
ALLOW_MEMORY_TRIP_STORE=false
